{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AquaTracker: Start server",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-aquatracker.ps1",
      "isBackground": true,
      "problemMatcher": {
        "owner": "aquatracker",
        "pattern": [{ "regexp": ".*" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting AquaTracker",
          "endsPattern": "AquaTracker running at"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
