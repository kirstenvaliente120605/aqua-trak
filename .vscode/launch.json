{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AquaTracker — Start (no extra debugger)",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-aquatracker.ps1",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "3001" },
      "preLaunchTask": null
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "AquaTracker running at (https?://\\S+)"
      }
    }
  ]
}
